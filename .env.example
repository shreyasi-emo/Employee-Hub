# --- Required ---
# Postgres connection string. Example: postgres://user:password@localhost:5432/employee_hub
DATABASE_URL=

# --- Recommended ---
# Secret used to sign session cookies. Use a long random string.
SESSION_SECRET=

# Port the server listens on (defaults to 5000)
PORT=5000

# --- Google OAuth (optional, enables Google sign-in) ---
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=
# Comma-separated list of email domains allowed to sign in, e.g. emoenergy.in
ALLOWED_EMAIL_DOMAINS=

# --- One-time admin bootstrap (optional) ---
BOOTSTRAP_TOKEN=

# --- Email via SendGrid (optional) ---
SENDGRID_API_KEY=
SENDGRID_FROM_EMAIL=
