# --- Required ---
# Postgres connection string. Example: postgres://user:password@localhost:5432/employee_hub
DATABASE_URL=

# --- Required in production ---
# Secret used to sign session cookies. Use a long random string (e.g. `openssl rand -hex 32`).
# The server refuses to start in production if this is unset (dev uses a per-boot ephemeral secret).
SESSION_SECRET=

# Port the server listens on (defaults to 5000)
PORT=5000

# --- Local development only ---
# Enables the /api/auth/dev-login and /api/auth/dev-role endpoints. Must be exactly "true".
# Always leave this UNSET in any deployed/production environment.
ENABLE_DEV_LOGIN=

# --- Google OAuth (optional, enables Google sign-in) ---
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=
# Comma-separated list of email domains allowed to sign in, e.g. emoenergy.in
ALLOWED_EMAIL_DOMAINS=

# --- One-time admin bootstrap (optional) ---
BOOTSTRAP_TOKEN=

# --- Email via SendGrid (optional) ---
SENDGRID_API_KEY=
SENDGRID_FROM_EMAIL=
